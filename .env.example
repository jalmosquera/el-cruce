# Shared local-development configuration for the future monorepo services.
# Copy to .env only for local development. Never commit the copied file.

# Allowed values: development, test, production.
# Test and production values must be supplied by their isolated environments.
EL_CRUCE_ENVIRONMENT=development

# Future PostgreSQL container defaults for local development only.
# Replace the password in your untracked .env; production credentials must not
# be stored in this repository.
POSTGRES_DB=elcruce_dev
POSTGRES_USER=elcruce_app
POSTGRES_PASSWORD=replace-with-a-local-development-password
