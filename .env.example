# Shared local-development configuration for Docker Compose.
# Copy to .env only for local development. Never commit the copied file.

# Allowed values: development, test, production.
# Test and production values must be supplied by their isolated environments.
EL_CRUCE_ENVIRONMENT=development

# PostgreSQL container defaults for local development only. Replace the password
# and Django secret in your untracked .env; production credentials must not be
# stored in this repository.
POSTGRES_DB=elcruce_dev
POSTGRES_USER=elcruce_app
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Django configuration used by the backend container. The backend rejects the
# placeholder secret at startup, so replace it before running Compose.
DJANGO_SECRET_KEY=replace-with-a-unique-local-development-secret-key
JWT_SIGNING_KEY=replace-with-a-separate-unique-local-jwt-signing-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# This is public browser configuration, not a secret. In Docker Compose, Vite
# proxies /api to the backend; future frontend code should prefer that relative path.
VITE_API_BASE_URL=/api
