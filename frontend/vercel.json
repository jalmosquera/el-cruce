{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "${BACKEND_URL}/api/$1",
      "env": ["BACKEND_URL"]
    },
    {
      "src": "/q/(.*)",
      "dest": "${BACKEND_URL}/q/$1",
      "env": ["BACKEND_URL"]
    },
    {
      "src": "/login",
      "dest": "/dashboard/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "src": "/dashboard/(.*)",
      "dest": "/dashboard/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    }
  ]
}
