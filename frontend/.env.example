# Vite frontend configuration. Every VITE_* value is included in the client
# bundle, so it must be public and must never contain secrets or credentials.

# Local development API origin. Test and production must provide their own
# public API base URL through their respective environment configuration.
VITE_API_BASE_URL=http://localhost:8000/api

# Public canonical origin used only while building static SEO files. It is not
# exposed to the browser bundle and must be an HTTPS origin only: no secret,
# credentials, path, query, or fragment. Production must set its approved
# public HTTPS origin before build.
# The generator uses https://elcruce.example only when this variable is absent.
PUBLIC_SITE_URL=https://elcruce.example
