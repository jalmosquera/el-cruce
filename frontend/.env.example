# Vite frontend configuration. Every VITE_* value is included in the client
# bundle, so it must be public and must never contain secrets or credentials.

# Local development API origin. This is public browser configuration, not a
# secret. In production it must use the approved same-site API origin including
# /api: https://api.<approved-domain>/api. Do not use an arbitrary provider URL:
# Vercel/Railway provider domains are cross-site and browser cookie auth is
# unsupported there, even when explicit CORS is configured.
VITE_API_BASE_URL=http://localhost:8000/api

# Optional browser-visible public origin used by dashboard QR copy actions. It
# must be the approved HTTPS origin without credentials, path, query or hash.
# If omitted, the dashboard displays and copies the safe relative /q/.../ path.
VITE_PUBLIC_SITE_URL=

# Public canonical origin used only while building static SEO files. It is not
# exposed to the browser bundle and must be an HTTPS origin only: no secret,
# credentials, path, query, or fragment. Production must set its approved
# public HTTPS origin before build.
# The generator uses https://elcruce.example only when this variable is absent.
PUBLIC_SITE_URL=https://elcruce.example
