# Django reads these values directly from the process environment; it does not load
# backend/.env automatically. Do not copy this file expecting Django to source it.
#
# Fish example for local development:
#   set -gx DJANGO_SECRET_KEY "replace-with-a-unique-local-development-secret-key"
#   set -gx JWT_SIGNING_KEY "replace-with-a-distinct-local-jwt-signing-key"
#   set -gx DJANGO_DEBUG true
#   set -gx DJANGO_ALLOWED_HOSTS "localhost,127.0.0.1"
#   set -gx POSTGRES_HOST "127.0.0.1"
#   set -gx POSTGRES_PORT 5432
#   set -gx POSTGRES_DB "elcruce_dev"
#   set -gx POSTGRES_USER "elcruce_app"
#   set -gx POSTGRES_PASSWORD "replace-with-a-local-development-password"
# Then run: uv run python manage.py runserver
#
# Use isolated test values in CI; inject production values through its secret store.

DJANGO_SECRET_KEY=replace-with-a-unique-local-development-secret-key
# Required separately from DJANGO_SECRET_KEY. Used exclusively to sign access and
# refresh JWTs; generate a unique high-entropy value for every environment.
JWT_SIGNING_KEY=replace-with-a-distinct-local-jwt-signing-key
DJANGO_DEBUG=true
# Comma-separated hostnames, without schemes or paths.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL is required for every environment. Replace all placeholder values
# before running Django; values in this file are not loaded automatically.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=elcruce_dev
POSTGRES_USER=elcruce_app
POSTGRES_PASSWORD=replace-with-a-local-development-password

# EL_CRUCE_ENVIRONMENT=test uses PostgreSQL database test_elcruce_dev through
# Django's TEST.NAME; it never uses POSTGRES_DB directly as the test database.
# Production: set EL_CRUCE_ENVIRONMENT=production, provide explicit
# DJANGO_ALLOWED_HOSTS, CORS/CSRF HTTPS origins, and inject unique non-placeholder
# credentials outside Git. Railway may instead provide one complete DATABASE_URL.
# When DATABASE_URL is set, POSTGRES_* variables are ignored by production settings.

# Production-only values. For browser authentication, deploy frontend and API on
# HTTPS subdomains of one approved registrable domain: app.<approved-domain> and
# api.<approved-domain>. Origins must be exact (no wildcards, paths, credentials,
# or queries); the cookie domain begins with a dot and has no scheme or path.
DJANGO_CORS_ALLOWED_ORIGINS=https://app.<approved-domain>
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.<approved-domain>
DJANGO_COOKIE_DOMAIN=.<approved-domain>
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
