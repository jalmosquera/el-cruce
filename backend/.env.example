# Django backend configuration. Copy to backend/.env for local development.
# Use isolated test values in CI; supply production values through its secret store.

DJANGO_SECRET_KEY=replace-with-a-unique-local-development-secret-key
DJANGO_DEBUG=true
# Comma-separated hostnames, without schemes or paths.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Future PostgreSQL connection configuration for the backend.
# Keep this password aligned with the local value configured for PostgreSQL.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=elcruce_dev
POSTGRES_USER=elcruce_app
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Test: use an isolated test database and test-only credentials.
# Production: set DJANGO_DEBUG=false, provide explicit DJANGO_ALLOWED_HOSTS,
# and inject a unique DJANGO_SECRET_KEY and database credentials outside Git.
