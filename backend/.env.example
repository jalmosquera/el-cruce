# Django reads these values directly from the process environment; it does not load
# backend/.env automatically. Do not copy this file expecting Django to source it.
#
# Fish example for local development:
#   set -gx DJANGO_SECRET_KEY "replace-with-a-unique-local-development-secret-key"
#   set -gx DJANGO_DEBUG true
#   set -gx DJANGO_ALLOWED_HOSTS "localhost,127.0.0.1"
# Then run: uv run python manage.py runserver
#
# Use isolated test values in CI; inject production values through its secret store.

DJANGO_SECRET_KEY=replace-with-a-unique-local-development-secret-key
DJANGO_DEBUG=true
# Comma-separated hostnames, without schemes or paths.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL variables are a future configuration contract only. Django does not
# read them and no PostgreSQL driver is installed until INFRA-03 owns that wiring.
# Keep this password aligned with the local value configured for PostgreSQL then.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=elcruce_dev
POSTGRES_USER=elcruce_app
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Test: use an isolated test database and test-only credentials.
# Production: set DJANGO_DEBUG=false, provide explicit DJANGO_ALLOWED_HOSTS,
# and inject a unique DJANGO_SECRET_KEY outside Git. INFRA-03 will define the
# production PostgreSQL connection variables and driver configuration.
